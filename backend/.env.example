PORT=5000
NODE_ENV=development
# mock | http | postgres. mock usa fixtures locales; postgres consulta la BD real (requiere DB_* abajo).
INVENTORY_MODE=postgres
INVENTORY_API_URL=
INVENTORY_LIST_PATH=
INVENTORY_DETAIL_PATH=
INVENTORY_LIST_ROOT=
INVENTORY_DETAIL_ROOT=
# Canonical field -> dotted external field path; e.g. {"id":"id_producto"}.
INVENTORY_FIELD_MAP={}
INVENTORY_API_TOKEN=
INVENTORY_TIMEOUT_MS=5000
# mock | postgres. Nunca habilites acceso a la BD compartida sin autorización.
ORDER_REPOSITORY=postgres
DB_ACCESS_ENABLED=true
DB_HOST=ep-royal-glade-ac55fitc-pooler.sa-east-1.aws.neon.tech
DB_PORT=5432
DB_NAME=si2_22026
DB_USER=si2_22026
DB_PASSWORD=
# URL completa usada por el repositorio de pedidos; codifica caracteres especiales (# -> %23).
DATABASE_URL=
# disabled | mock | http. Disabled records pending, never a fake success.
CRM_MODE=disabled
# Enable only after the CRM team confirms durable deduplication for this header.
CRM_IDEMPOTENCY_SUPPORTED=false
CRM_API_URL=
CRM_ORDER_PATH=
CRM_API_TOKEN=
CRM_TIMEOUT_MS=5000
