PORT=5000
NODE_ENV=development
# mock | http. Mock uses clearly identified backend fixtures (slug IDs).
INVENTORY_MODE=mock
INVENTORY_API_URL=
# Required in http mode; use paths confirmed by the Inventory team.
INVENTORY_LIST_PATH=
INVENTORY_DETAIL_PATH=
# Empty means root JSON. Detail path must contain {id}.
INVENTORY_LIST_ROOT=
INVENTORY_DETAIL_ROOT=
# Canonical field -> dotted external field path; e.g. {"id":"id_producto"}.
INVENTORY_FIELD_MAP={}
INVENTORY_API_TOKEN=
INVENTORY_TIMEOUT_MS=5000
# mock | postgres. Never enable shared DB access without authorization.
ORDER_REPOSITORY=mock
DB_ACCESS_ENABLED=false
DATABASE_URL=
# disabled | mock | http. Disabled records pending, never a fake success.
CRM_MODE=disabled
# Enable only after the CRM team confirms durable deduplication for this header.
CRM_IDEMPOTENCY_SUPPORTED=false
CRM_API_URL=
CRM_ORDER_PATH=
CRM_API_TOKEN=
CRM_TIMEOUT_MS=5000
