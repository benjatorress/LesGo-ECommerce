# Same-origin /api uses Vite proxy locally and Nginx in Docker.
VITE_API_URL=/api
# local shows frontend PRODUCTS with filters; api uses the backend, without fallback.
VITE_CATALOG_SOURCE=local
# Existing offline login demo is opt-in; tokens cannot authorize backend orders.
VITE_AUTH_OFFLINE_DEMO=false
# URL del formulario externo de solicitud de devoluciones.
VITE_RETURN_REQUEST_URL=https://example.com/solicitar-devolucion
